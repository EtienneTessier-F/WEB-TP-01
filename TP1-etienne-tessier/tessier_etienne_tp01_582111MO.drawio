                <mxCell id="DLwB6ZPBjGfOhc-bZ8L--31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div&gt;L&#39;Horizon sans fin&lt;br&gt;&lt;div&gt;Guidé par votre fidèle destrier, vous atteignez les falaises surplombant une mer inconnue oû navigue un navire au voiles dorées. Une nouvelle aventure se dessine au loin.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="130" width="240" x="860" y="880" as="geometry"/>
                </mxCell>
                <mxCell id="DLwB6ZPBjGfOhc-bZ8L--32" edge="1" parent="1" source="DLwB6ZPBjGfOhc-bZ8L--33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="DLwB6ZPBjGfOhc-bZ8L--39">
