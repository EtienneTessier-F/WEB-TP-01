                <mxCell id="DLwB6ZPBjGfOhc-bZ8L--33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;p1&quot;&gt;Les portes de l&#39;oubli&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;À peine franchi le seuil du château, la herse en fer retombe lourdement derrière vous. Des ombres squelettiques émergent des murs et vous encerclent sans moindre échapatoire.&lt;/p&gt;" vertex="1">
                    <mxGeometry height="130" width="230" x="1110" y="880" as="geometry"/>
