                <mxCell id="DLwB6ZPBjGfOhc-bZ8L--27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;p1&quot;&gt;La retraite prudente&lt;br&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot;&gt;Sentant le danger imminent, vous faites vivement quelques pas en arrière pour vous éloigner du souffle arcanique. Les runes s&#39;apaisent doucement et l&#39;air retrouve son calme autour de l&#39;autel&lt;/p&gt;" vertex="1">
                    <mxGeometry height="130" width="220" x="330" y="880" as="geometry"/>
                </mxCell>
                <mxCell id="DLwB6ZPBjGfOhc-bZ8L--28" edge="1" parent="1" source="DLwB6ZPBjGfOhc-bZ8L--29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="DLwB6ZPBjGfOhc-bZ8L--5">
